# HAU SOC Badging System — production Compose environment
# Copy to /etc/hau-soc/production.env, set mode 0600, and replace every placeholder.
# Do not commit the completed file. Do not copy local .env values.
# Secrets are NOT stored here; see deploy/secrets/README.md.

# ---- Network / reverse proxy ----
# NPM on the same VM: keep loopback binding and forward to host.docker.internal:3001.
# NPM on another machine: set APP_BIND_ADDRESS to a dedicated private interface and
# firewall it so only the NPM host can reach this port. Never bind 0.0.0.0 publicly.
APP_BIND_ADDRESS=127.0.0.1
APP_HOST_PORT=3001
APP_URL=https://badges.example.edu
ISSUER_URL=https://badges.example.edu/api/issuers/hau-soc
ISSUER_NAME=Holy Angel University — School of Computing
ISSUER_LOGO_PATH=/images/hausoclogo.png
# NPM must be the only route to the app and must overwrite X-Forwarded-For.
TRUST_PROXY=true

# ---- Database (non-secret names only) ----
MARIADB_DATABASE=badging
MARIADB_USER=badging
MARIADB_BINLOG_RETENTION_DAYS=14

# ---- Signing identity (public metadata only) ----
SIGNING_KEY_ID=https://badges.example.edu/api/issuers/hau-soc/keys/key-2026-01
SIGNING_PUBLIC_MULTIKEY=replace-with-public-multikey-from-generated-metadata
SIGNING_KEY_FINGERPRINT=replace-with-public-fingerprint-from-generated-metadata
SIGNING_CRYPTOSUITE=eddsa-rdfc-2022
SIGNER_TIMEOUT_MS=5000

# ---- Email delivery ----
EMAIL_DELIVERY_MODE=brevo
# local = Mailpit only; staging = exact-recipient allowlist; production = authorized system recipients.
EMAIL_RECIPIENT_POLICY=production
EXTERNAL_EMAIL_ENABLED=true
# Leave false for normal production. Set true only for an approved controlled acceptance run.
CONTROLLED_ACCEPTANCE_ONLY=false
# Production policy does not require an allowlist. Use staging policy with this list for controlled tests.
EXTERNAL_EMAIL_ALLOWLIST=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=replace-with-brevo-smtp-login
BREVO_SENDER=HAU SOC Badging System <badges@hau.edu.ph>
BREVO_WEBHOOK_ENABLED=true

# ---- Notification worker ----
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_CLAIM_LEASE_SECONDS=120
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_DELAY_SECONDS=60
NOTIFICATION_BATCH_SIZE=20

# ---- Initial Administrator (one-time seed; password lives in SECRETS_DIR) ----
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@hau.edu.ph

# ---- Secrets directory on the Docker host (files documented in deploy/secrets/README.md) ----
SECRETS_DIR=/etc/hau-soc/secrets

# ---- Backup policy inputs (host-side scripts, not read by the app) ----
BACKUP_ROOT=/var/backups/hau-soc
BACKUP_RETENTION_DAYS=30
SIGNING_KEY_BACKUP_RETENTION_DAYS=365
BACKUP_ENCRYPTION_PASSPHRASE_FILE=/etc/hau-soc/backup-passphrase
