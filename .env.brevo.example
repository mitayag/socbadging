# Brevo SMTP example — placeholders only. Do not commit a populated copy.
# Copy to a private environment file and load only for an authorized test.
EMAIL_DELIVERY_MODE=brevo
EMAIL_RECIPIENT_POLICY=staging
EXTERNAL_EMAIL_ENABLED=false
CONTROLLED_ACCEPTANCE_ONLY=false
EXTERNAL_EMAIL_ALLOWLIST=authorized-test-recipient@example.org
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=replace-with-brevo-smtp-username
BREVO_SMTP_PASSWORD=replace-with-brevo-smtp-password
BREVO_SENDER=HAU SOC Badging System <badges@hausoc.org>
BREVO_WEBHOOK_ENABLED=false
BREVO_WEBHOOK_SECRET=replace-with-brevo-webhook-secret
